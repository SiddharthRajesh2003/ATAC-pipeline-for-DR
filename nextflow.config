params {
    base = "/scratch/srajes23/ATAC-seq-pipeline-for-Diabetic-Retinopathy-paper"
    results = "${params.base}/results"
    samplesheet = "${projectDir}/samplesheet/samplesheet.csv"

    // Shared with the RNA-seq pipeline: same <prefix>_ref.fa / <prefix>_annotation.gtf.
    // The Bowtie2 index is built once and published next to the STAR index.
    reference = "/data/srangas1/RNA-seq-pipeline-for-Diabetic-Retinopathy-paper/reference"

    // MACS3 effective genome sizes, keyed by the samplesheet organism column
    // ponytail: rat value is ~93% of rn8 length; compute with unique k-mers if rat ATAC is ever run
    macs_gsize = [
        mus_musculus      : '1.87e9',
        homo_sapiens      : '2.7e9',
        rattus_norvegicus : '2.5e9'
    ]

    trimmed_reads_dir = "${params.results}/trimmed_reads"
    fastqc_dir = "${params.results}/fastqc"
    align_logs_dir = "${params.results}/alignment/logs"
    picard_dir = "${params.results}/alignment/picard"
    filtered_dir = "${params.results}/alignment/filtered_bam"
    flagstat_dir = "${params.results}/flagstat"
    stats_dir = "${params.results}/samtools_stats"
    bigwig_dir = "${params.results}/bigwig"
    peaks_dir = "${params.results}/peaks"
    consensus_dir = "${params.results}/consensus_peaks"
    counts_dir = "${params.results}/counts"
    multiqc_dir = "${params.results}/multiqc"
}

profiles {
    slurm {

        apptainer {
            enabled = true
            cacheDir = "/data/srangas1/RNA-seq-pipeline-for-Diabetic-Retinopathy-paper/containers/cache"
        }

        executor {
            queueSize = 125
        }

        report {
            overwrite = true
        }

        timeline {
            overwrite = true
        }

        process {
            executor = 'slurm'
            queue = 'public'
            clusterOptions = '-A grp_srangas1'

            errorStrategy = { task.attempt <= 2 ? 'retry' : 'terminate' }
            maxRetries = 2

            cpus = 1
            memory = 10.GB
            time = 48.h

            // --- preprocessing ---
            withName: 'Fastp' {
                cpus = 4
                memory = 32.GB
                time = 3.h
            }

            withName: 'FastQC' {
                cpus = 2
                memory = { 4.GB * task.attempt }
                time = 2.h
            }

            // --- reference indexing ---
            withName: 'Bowtie2Index' {
                cpus = 16
                memory = 32.GB
                time = 8.h
            }

            // --- alignment ---
            withName: 'Bowtie2Align' {
                cpus = 16
                memory = { 16.GB * task.attempt }
                time = 12.h
            }

            // --- bam processing ---
            withName: 'sort' {
                cpus = 8
                memory = 16.GB
                time = 3.h
            }

            withName: 'MarkDuplicates' {
                cpus = 2
                memory = 32.GB
                time = 4.h
            }

            withName: 'FilterBam' {
                cpus = 4
                memory = 8.GB
                time = 3.h
            }

            withName: 'flagstat' {
                cpus = 4
                memory = 4.GB
                time = 1.h
            }

            withName: 'stats' {
                cpus = 4
                memory = 4.GB
                time = 1.h
            }

            withName: 'BamCoverage' {
                cpus = 8
                memory = 16.GB
                time = 3.h
            }

            // --- peaks ---
            withName: 'CallPeaks' {
                cpus = 1
                memory = { 16.GB * task.attempt }
                time = 4.h
            }

            withName: 'ConsensusPeaks' {
                cpus = 1
                memory = 8.GB
                time = 1.h
            }

            withName: 'FeatureCounts' {
                cpus = 8
                memory = 16.GB
                time = 4.h
            }

            // --- reporting ---
            withName: 'MultiQC' {
                cpus = 2
                memory = 4.GB
                time = 1.h
            }
        }
    }
}
